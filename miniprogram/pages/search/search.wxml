<view class="circle">
  <input class='search' auto-focus placeholder="请输入城市名称" bindconfirm="bindconfirmT" bindinput="bindKeyInput" placeholder-class="placeholder" />
</view>

<view class="container">
  <view class="divLineLong"></view>
</view>

<navigator block wx:for="{{city}}" wx:key="_id" url="/pages/cityDetail/cityDetail?city_id={{item._id}}">
  <view>
    <view class="catitem">
      <image class='avator' lazy-load='true' src="{{item.avatar}}" mode='aspectFill'></image>
      <view class="cat-name">{{item.name}}</view>
    </view>
    <view class="divLine"></view>
  </view>
</navigator>
