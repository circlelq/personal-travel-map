/* 主色与文字色定义在 app.wxss，这里只补本页独有的浮层底色 */
page {
  --surface: rgba(255, 255, 255, 0.94);
  height: 100%;
}

.map-wrap {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 顶部统计，独立于地图之外 */
.topbar {
  flex: none;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: #ffffff;
}

.stat {
  display: flex;
  align-items: baseline;
}

.topbar-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.map-holder {
  position: relative;
  flex: 1;
  min-height: 0;
}

.map {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
}

.stat-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 右下角控件组 */
.controls {
  position: absolute;
  right: 24rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ctrl {
  width: 88rpx;
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl:first-child {
  margin-top: 0;
}

.ctrl-text {
  font-size: 24rpx;
  color: var(--text-primary);
}

.ctrl-icon {
  font-size: 40rpx;
  color: var(--brand);
}

/* 底部城市卡片 */
.card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  opacity: 0;
  transform: translateY(160%);
  transition: transform 0.24s ease, opacity 0.24s ease;
}

.card-show {
  opacity: 1;
  transform: translateY(0);
}

.card-avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
}

.card-info {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
}
