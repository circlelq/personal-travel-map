<!-- map.wxml -->
<view class="map-wrap">
  <!-- 统计放在地图之外，避开地图自带的指南针与比例尺 -->
  <view class="topbar" wx:if="{{cityCount}}">
    <view class="stat">
      <text class="stat-num">{{cityCount}}</text>
      <text class="stat-label">座城市</text>
    </view>
    <text class="topbar-tip">点击标记查看城市</text>
  </view>

  <view class="map-holder">
    <map
      id="map"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      min-scale="3"
      max-scale="18"
      markers="{{markers}}"
      show-location
      show-scale
      show-compass
      enable-rotate
      enable-overlooking
      bindmarkertap="markertap"
      bindtap="tapMap">
    </map>

    <!-- 右下角控件 -->
    <view class="controls">
      <view class="ctrl" bindtap="clickBack">
        <text class="ctrl-text">全部</text>
      </view>
      <view class="ctrl" bindtap="clickLocation">
        <text class="ctrl-icon">◎</text>
      </view>
    </view>

    <!-- 选中标记后浮出的城市卡片 -->
    <view class="card {{showCard ? 'card-show' : ''}}" hidden="{{!selected}}">
      <image class="card-avatar" src="{{selected.avatar}}" mode="aspectFill"></image>
      <view class="card-info">
        <view class="card-name">{{selected.name}}</view>
      </view>
      <view class="card-btn" bindtap="goDetail">详情 ›</view>
    </view>
  </view>
</view>
