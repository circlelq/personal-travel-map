<!-- map.wxml -->
<view class="map-wrap">
  <map
    id="map"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    min-scale="3"
    max-scale="18"
    markers="{{markers}}"
    show-location
    show-scale
    show-compass
    enable-rotate
    enable-overlooking
    bindmarkertap="markertap"
    bindtap="tapMap"
    bindregionchange="regionchange">
  </map>

  <!-- 左上角足迹统计 -->
  <view class="stat" wx:if="{{markers.length}}">
    <text class="stat-num">{{markers.length}}</text>
    <text class="stat-label">个足迹</text>
  </view>

  <!-- 右下角控件 -->
  <view class="controls">
    <view class="ctrl" bindtap="clickBack">
      <text class="ctrl-text">全部</text>
    </view>
    <view class="ctrl" bindtap="clickLocation">
      <text class="ctrl-icon">◎</text>
    </view>
  </view>

  <!-- 选中标记后浮出的城市卡片 -->
  <view class="card {{showCard ? 'card-show' : ''}}" hidden="{{!selected}}">
    <image class="card-avatar" src="{{selected.avatar}}" mode="aspectFill"></image>
    <view class="card-info">
      <view class="card-name">{{selected.name}}</view>
    </view>
    <view class="card-btn" bindtap="goDetail">详情 ›</view>
  </view>
</view>
