/* pages/cityEdit/cityEdit.wxss */
/* 这里不重复定义 --brand 等变量，统一取 app.wxss */
page {
  background: var(--page-bg);
  /* 底部固定操作栏的高度 + 安全区 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.page {
  padding: 24rpx 24rpx 0;
}

/* 顶部封面 */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
}

.hero-cover {
  display: block;
  width: 100%;
  height: 240rpx;
}

.hero-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 24rpx 20rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.tip {
  margin: 20rpx 4rpx 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.section {
  margin-top: 12rpx;
}

.section-title {
  margin: 20rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 每张照片一行：左边缩略图，右边表单 */
.photo-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.photo-thumb {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.photo-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.field {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.field:last-of-type {
  border-bottom: none;
}

.field-label {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-input {
  line-height: 64rpx;
}

.field-placeholder {
  color: #b5b5b5;
}

.field-clear {
  flex-shrink: 0;
  padding: 6rpx 0 6rpx 16rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.photo-file {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b5b5b5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 60rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.footer {
  padding: 24rpx 0 40rpx;
  font-size: 22rpx;
  color: #b5b5b5;
  text-align: center;
}

/* 加载 / 失败 */
.state {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 底部操作栏 */
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
  border-radius: 44rpx;
}

.btn-ghost {
  margin-right: 16rpx;
  color: var(--text-primary);
  background: #f0f0f0;
}

.btn-primary {
  color: #ffffff;
  background: var(--brand);
}

.btn-disabled {
  opacity: 0.4;
}
