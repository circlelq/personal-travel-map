<view class="page" wx:if="{{!loading && !error}}">
  <view class="hero">
    <image class="hero-cover" src="{{cover}}" mode="aspectFill" binderror="onCoverError"></image>
    <view class="hero-body">
      <view class="hero-name">{{cityName}}</view>
      <view class="hero-sub">{{photos.length}} 张照片</view>
    </view>
  </view>

  <view class="tip">
    景点相同的照片会在详情页放到一组；留空归入「其他照片」。
    填第一行景点时，后面还没填的会自动跟着填。
  </view>

  <view class="section" wx:if="{{photos.length}}">
    <view class="section-title">照片信息</view>

    <view class="photo-card" wx:for="{{photos}}" wx:key="key">
      <image
        class="photo-thumb"
        src="{{item.preview}}"
        mode="aspectFill"
        bindtap="previewPhoto"
        data-index="{{index}}"
      ></image>

      <view class="photo-main">
        <view class="field">
          <text class="field-label">景点</text>
          <input
            class="field-input"
            value="{{item.spot}}"
            placeholder="分组用，可不填"
            placeholder-class="field-placeholder"
            maxlength="20"
            adjust-position="true"
            data-index="{{index}}"
            bindinput="onSpotInput"
          ></input>
        </view>

        <view class="field">
          <text class="field-label">名称</text>
          <input
            class="field-input"
            value="{{item.title}}"
            placeholder="{{item.file}}"
            placeholder-class="field-placeholder"
            maxlength="30"
            adjust-position="true"
            data-index="{{index}}"
            bindinput="onTitleInput"
          ></input>
        </view>

        <view class="field">
          <text class="field-label">日期</text>
          <picker mode="date" value="{{item.date}}" data-index="{{index}}" bindchange="onDateChange">
            <view class="field-input picker-input {{item.date ? '' : 'field-placeholder'}}">
              {{item.date ? item.date : '未设置'}}
            </view>
          </picker>
          <view
            class="field-clear"
            wx:if="{{item.date}}"
            data-index="{{index}}"
            bindtap="onClearDate"
          >清空</view>
        </view>

        <view class="photo-file">文件 {{item.file}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!photos.length}}">这座城市还没有照片</view>

  <view class="footer">保存后返回首页即可看到最新内容</view>
</view>

<view class="state" wx:if="{{loading}}">
  <view class="state-text">加载中…</view>
</view>
<view class="state" wx:if="{{error}}">
  <view class="state-text">{{error}}</view>
</view>

<view class="actionbar" wx:if="{{!loading && !error}}">
  <view class="btn btn-ghost" bindtap="onCancel">取消</view>
  <view class="btn btn-primary {{dirty && !saving ? '' : 'btn-disabled'}}" bindtap="onSave">
    {{saving ? '保存中…' : '保存'}}
  </view>
</view>
