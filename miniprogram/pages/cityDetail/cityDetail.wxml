<view class="title">
  <text user-select="true">{{city.name}}</text>
</view>
<view style="display:flex; justify-content:center; align-items:center;">
  <image mode="widthFix" src="{{photoscr}}" style="width: 90%;">
  </image>
</view>

<view class="itemname1">
  <view wx:if="{{city.officialAccount['bili']}}" bindtap="naviToMiniBili" style='flex-shrink:0; box-sizing:border-box; width:3rem; margin-right:2rem; margin-bottom:1rem;'>
    <image style="width:3rem;height:3rem;" src="/pages/images/bili.png"></image>
    <view style="text-align: center;  color:#353535;"> \n B 站 </view>
  </view>
  <view wx:if="{{city.officialAccount['xhs']}}" bindtap="naviToMiniXhs" style='flex-shrink:0; box-sizing:border-box; width:3rem; margin-right:2rem; margin-bottom:1rem;'>
    <image style="width:3rem;height:3rem;" src="/pages/images/xhs.png"></image>
    <view style="text-align: center;  color:#353535;"> \n 小红书 </view>
  </view>
</view>

<block wx:for="{{city.photo}}">
  <view style="display:flex; justify-content:center; align-items:center;">
    <image mode="widthFix" src="https://city-1257850266.cos.ap-guangzhou.myqcloud.com/%E9%A2%84%E8%A7%88%E5%9B%BE/{{city.name}}/{{item[0]}}.jpg" style="width: 90%;">
    </image>
  </view>
  <text> \n </text>
  <!-- <text user-select="true">{{item[0]}}</text> -->
</block>

<block wx:for="{{city.mainContent}}">
  <view class="{{item[0]}}">
    <text user-select="true">{{item[1]}}</text>
  </view>
</block>

<text> \n </text>

<view style="display:flex; justify-content:center; align-items:center;">
  <map id="map" bindcontroltap="controltap" bindupdated="includePointsOne" markers="{{markers}}" bindmarkertap="markertap" bindregionchange="regionchange" show-location style="width: 90%; height: 300px;"></map>
</view>

<text> \n </text>