/* pages/cityDetail/cityDetail.wxss */
page {
  background: var(--page-bg);
}

.page {
  padding-bottom: 40rpx;
  background: var(--page-bg);
  min-height: 100vh;
}

/* 封面 */
.hero {
  background: #fff;
}

.hero-cover {
  display: block;
  width: 100%;
}

.hero-body {
  padding: 32rpx 32rpx 28rpx;
}

.hero-name {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 概览 */
.stats {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat:not(:last-child) {
  border-right: 1rpx solid #f0f0f0;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 外链 */
.links {
  display: flex;
  margin: 0 24rpx 20rpx;
}

.link {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 14rpx 28rpx 14rpx 20rpx;
  background: #fff;
  border-radius: 999rpx;
}

.link-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.link-text {
  font-size: 26rpx;
  color: var(--brand);
}

/* 区块 */
.section {
  margin: 0 24rpx 20rpx;
}

.section-title {
  margin: 12rpx 8rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 照片：按景点分组，组内两列网格 */
.spot {
  margin-bottom: 20rpx;
}

.spot-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
}

.spot-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.spot-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  /* 负边距抵掉格子左右的外边距，让首尾两格贴齐区块边界 */
  margin: 0 -6rpx;
}

.cell {
  width: calc(50% - 12rpx);
  margin: 0 6rpx 12rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 组内最后一张落单时占满整行 */
.cell-wide {
  width: calc(100% - 12rpx);
}

/* 半格用定高 + 裁切，保证两列始终对齐 */
.cell-img {
  display: block;
  width: 100%;
  height: 340rpx;
}

/* 整宽的走 widthFix，按原图比例显示，不裁切 */
.cell-wide .cell-img {
  height: auto;
}

.cell-legend {
  padding: 14rpx 18rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 地图 */
.map-card {
  border-radius: 16rpx;
  overflow: hidden;
}

.city-map {
  width: 100%;
  height: 420rpx;
}

.map-tip {
  margin: 16rpx 8rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.footer {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c8c8c8;
}

/* 加载中 / 加载失败 */
.state {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
