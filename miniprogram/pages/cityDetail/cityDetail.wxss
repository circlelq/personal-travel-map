/* pages/cityDetail/cityDetail.wxss */
page {
  background: var(--page-bg);
}

.page {
  padding-bottom: 40rpx;
  background: var(--page-bg);
  min-height: 100vh;
}

/* 封面 */
.hero {
  background: #fff;
}

.hero-cover {
  display: block;
  width: 100%;
}

.hero-body {
  padding: 32rpx 32rpx 28rpx;
}

.hero-name {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 概览 */
.stats {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat:not(:last-child) {
  border-right: 1rpx solid #f0f0f0;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 外链 */
.links {
  display: flex;
  margin: 0 24rpx 20rpx;
}

.link {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 14rpx 28rpx 14rpx 20rpx;
  background: #fff;
  border-radius: 999rpx;
}

.link-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.link-text {
  font-size: 26rpx;
  color: var(--brand);
}

/* 区块 */
.section {
  margin: 0 24rpx 20rpx;
}

.section-title {
  margin: 12rpx 8rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 照片 */
.photo {
  margin-bottom: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  display: block;
  width: 100%;
}

.legend {
  padding: 20rpx 24rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 地图 */
.map-card {
  border-radius: 16rpx;
  overflow: hidden;
}

.city-map {
  width: 100%;
  height: 420rpx;
}

.map-tip {
  margin: 16rpx 8rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.footer {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c8c8c8;
}

/* 加载中 / 加载失败 */
.state {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
