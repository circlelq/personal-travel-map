<!--index.wxml-->
<view class="page">
  <navigator class="searchbar" url="/pages/search/search">
    <image class="searchbar-avatar" src="/pages/images/circle.png" mode="aspectFill"></image>
    <text class="searchbar-text">搜索城市</text>
  </navigator>

  <view class="waterfall">
    <view class="waterfall-col" wx:for="{{columns}}" wx:for-item="column" wx:for-index="colIndex" wx:key="colIndex">
      <navigator class="card" wx:for="{{column}}" wx:for-item="item" wx:key="_id" url="/pages/cityDetail/cityDetail?city_id={{item._id}}">
        <image class="card-cover" src="{{item.cover}}" mode="widthFix" lazy-load="true"></image>
        <view class="card-body">
          <view class="card-title">{{item.name}}</view>
          <view class="card-meta">{{item.photoCount}} 张照片</view>
        </view>
      </navigator>
    </view>
  </view>
</view>
