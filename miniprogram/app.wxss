/**app.wxss**/
page {
  /* 全局设计变量：主色与文字色，改配色只改这里 */
  --brand: #557e56;
  --text-primary: #2c2c2a;
  --text-secondary: #8a8a8a;
  --page-bg: #f7f8f7;
}

/* 详情页城市名 */
.title {
  font-size: 45rpx;
  text-align: center;
  margin-top: 14rpx;
  margin-bottom: 14rpx;
  font-weight: bold;
}

/* 详情页 B 站、小红书入口行 */
.itemname1 {
  font-size: 27rpx;
  margin-left: 40rpx;
  margin-right: 40rpx;
  margin-bottom: 30rpx;
  margin-top: 30rpx;
  display: flex;
  color: #888888;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
}
